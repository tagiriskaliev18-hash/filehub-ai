# Copy this file to .env and fill in real values. Never commit .env.

# --- API server ---
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
SESSION_COOKIE_NAME=fh_session

# --- Database (SQLite file, created by `npm run prisma:migrate`) ---
DATABASE_URL="file:./dev.db"

# --- Local object storage root (relative to apps/api) ---
STORAGE_ROOT=../../storage

# --- AI agent (optional). Without this, the app runs in degradation mode:
# file manager / compression / conversion still work, AI features are disabled. ---
ANTHROPIC_API_KEY=

# --- Alternative to Anthropic: any OpenAI-compatible chat-completions server
# (e.g. a self-hosted LocalAI instance) — keeps document content on internal
# infrastructure instead of an external API. Set AI_PROVIDER=localai to use
# this instead of ANTHROPIC_API_KEY above; leave unset/"anthropic" otherwise.
# Before relying on this in production, confirm the chosen model actually
# supports tool/function calling AND follows the agent's safety rules (see
# the system prompt in agent.service.ts) as reliably as Claude does — a
# smaller/local model is not guaranteed to hold those boundaries the same
# way under a determined user, and that's the whole reason those rules exist.
AI_PROVIDER=anthropic
LOCALAI_BASE_URL=
LOCALAI_API_KEY=
LOCALAI_MODEL=

# How the agent renders scanned-PDF pages for a model to read (see
# tools/pdf.ts) — the lever for fitting more pages/files in one conversation
# without exceeding a small local model's context window. Safe to raise
# these with Anthropic's much larger context; with a small local model,
# raising them (or attaching many/large files at once) risks the request
# exceeding context and the connection dropping outright.
AGENT_PDF_MAX_PAGES=6
AGENT_PDF_IMAGE_SCALE=1.5
AGENT_PDF_IMAGE_QUALITY=65

# --- Corporate network restriction stand-in for real SSO/ZTNA (ТЗ §6.5). ---
# Comma-separated list of allowed IPv4 CIDR ranges. Leave empty to allow any network
# (useful for local dev). Example: "10.0.0.0/8,192.168.1.0/24"
ALLOWED_CIDRS=

# CORS reflects whatever origin a request came from (see app.ts) — the actual
# access boundary for this LAN deployment is the network/CIDR check above,
# not the browser's CORS origin, so no WEB_ORIGIN configuration is needed.
