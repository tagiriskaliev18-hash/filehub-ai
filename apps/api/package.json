    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^5.20.0",
    "archiver": "^7.0.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.0.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
